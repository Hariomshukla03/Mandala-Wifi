# Optional: enable Plausible analytics. Analytics is off by default.
VITE_ANALYTICS_ID=
# Replace with your actual website URL before production build.
VITE_SITE_URL=https://mandalabroadband.example
# Production Node server port.
PORT=3000

# EmailJS browser integration (public identifiers, never passwords/private keys).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
