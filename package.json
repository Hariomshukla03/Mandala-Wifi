  "devDependencies": {"@types/node":"^22.10.2","@types/react":"^18.3.17","@types/react-dom":"^18.3.5","@vitejs/plugin-react":"^5.0.0","autoprefixer":"^10.4.20","postcss":"^8.4.49","tailwindcss":"^3.4.17","typescript":"^5.7.2","vite":"^7.1.0"},
